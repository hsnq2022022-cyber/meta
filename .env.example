# ============================================
# إدارة سوشيال - Social Management
# Environment Variables
# ============================================

# ============================================
# SUPABASE
# ============================================
# Supabase Project URL
# أين يستخدم: Frontend + Backend
# هل هو سري: لا
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (Public)
# أين يستخدم: Frontend
# هل هو سري: لا (مصمم ليكون عامًا)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key
# أين يستخدم: Backend فقط (Edge Functions / Server)
# هل هو سري: نعم - لا تضعه في Frontend أبداً
# هل يحتاج Railway: نعم
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Project Reference
# أين يستخدم: Backend
# هل هو سري: لا
SUPABASE_PROJECT_REF=your-project-ref

# ============================================
# META (Facebook / Instagram)
# ============================================
# Meta App ID
# أين يستخدم: Backend (OAuth + API calls)
# هل هو سري: لا
# هل يحتاج Railway: نعم
META_APP_ID=your-meta-app-id

# Meta App Secret
# أين يستخدم: Backend فقط
# هل هو سري: نعم - لا تضعه في Frontend أبداً
# هل يحتاج Railway: نعم
# هل يحتاج تدوير: نعم - كل 90 يوم
META_APP_SECRET=your-meta-app-secret

# Meta Graph API Version
# أين يستخدم: Backend
# هل هو سري: لا
META_GRAPH_API_VERSION=v19.0

# Meta OAuth Redirect URI
# أين يستخدم: Backend + Meta App Settings
# هل هو سري: لا
# ملاحظة: يجب أن يتطابق مع إعدادات Meta App
META_REDIRECT_URI=https://your-domain.com/api/auth/meta/callback

# Meta Webhook Verify Token
# أين يستخدم: Backend (Webhook verification)
# هل هو سري: نعم
# هل يحتاج Railway: نعم
META_WEBHOOK_VERIFY_TOKEN=your-random-verify-token-here

# Meta App Secret Proof
# أين يستخدم: Backend (Graph API calls)
# هل هو سري: يُحسب تلقائياً من APP_SECRET
# ملاحظة: يُنشأ لكل طلب باستخدام HMAC-SHA256
META_APP_SECRET_PROOF=auto-generated-per-request

# ============================================
# SECURITY
# ============================================
# Encryption Key for tokens
# أين يستخدم: Backend
# هل هو سري: نعم
# هل يحتاج Railway: نعم
# هل يحتاج تدوير: نعم - سنوياً
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Session Secret
# أين يستخدم: Backend
# هل هو سري: نعم
SESSION_SECRET=your-session-secret-here

# ============================================
# AI PROVIDER
# ============================================
# AI Provider API Key (OpenAI / Anthropic / etc.)
# أين يستخدم: Backend (Edge Functions)
# هل هو سري: نعم
# هل يحتاج Railway: نعم
AI_PROVIDER_API_KEY=your-ai-api-key-here

# AI Model
# أين يستخدم: Backend
# هل هو سري: لا
AI_MODEL=gpt-4o-mini

# ============================================
# STORAGE
# ============================================
# Storage Bucket Name
# أين يستخدم: Backend + Frontend
# هل هو سري: لا
STORAGE_BUCKET=knowledge-files

# ============================================
# INFRASTRUCTURE
# ============================================
# Redis URL (for queues/caching)
# أين يستخدم: Backend
# هل هو سري: نعم
# هل يحتاج Railway: نعم (إذا تم استخدام Redis)
REDIS_URL=redis://default:password@host:port

# ============================================
# URLS
# ============================================
# Frontend URL
# أين يستخدم: Backend (CORS, redirects)
# هل هو سري: لا
FRONTEND_URL=https://your-frontend-domain.com

# Backend URL
# أين يستخدم: Frontend (API calls), Meta (Webhook)
# هل هو سري: لا
BACKEND_URL=https://your-backend-domain.com

# ============================================
# LOGGING
# ============================================
# Log Level
# أين يستخدم: Backend
# هل هو سري: لا
LOG_LEVEL=info

# ============================================
# ملاحظات مهمة
# ============================================
# 1. لا تبدأ أي متغير سري بـ VITE_ إلا إذا كان عاماً فعلاً
# 2. المتغيرات التي تبدأ بـ VITE_ تكون متاحة في Frontend
# 3. كل الأسرار يجب أن تكون في Railway Environment Variables
# 4. لا تضع أي مفتاح سري في الكود أو Git
# 5. استخدم .env.local للتطوير المحلي (مُضاف لـ .gitignore)
